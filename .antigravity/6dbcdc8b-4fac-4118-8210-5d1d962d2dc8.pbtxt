      id: "call_10831348398006073491"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useCallback, useEffect, useState } from \'react\';\\nimport {\\n  createInitialProjects,\\n  createInitialReflection,\\n  createInitialTasks,\\n  DEFAULT_PREFERENCES,\\n} from \'../data/initialData\';\\nimport {\\n  Priority,\\n  Project,\\n  ProjectAccent,\\n  ReflectionEntry,\\n  Subtask,\\n  Task,\\n  TaskStatus,\\n  UserPreferences,\\n} from \'../types/taskflow\';\\nimport { getWeekKey } from \'../utils/dates\';\\n\\nconst STORAGE_KEYS = {\\n  tasks: \'taskflow_narrative_tasks_v1\',\\n  projects: \'taskflow_narrative_projects_v1\',\\n  prefs: \'taskflow_narrative_prefs_v1\',\\n  reflection: \'taskflow_narrative_reflection_v1\',\\n};\\n\\nfunction loadFromStorage<T>(key: string, fallback: () => T): T {\\n  try {\\n    const raw = localStorage.getItem(key);\\n    if (!raw) return fallback();\\n    return JSON.parse(raw) as T;\\n  } catch {\\n    return fallback();\\n  }\\n}\\n\\nexport function useTaskStore() {\\n  const [tasks, setTasks] = useState<Task[]>(() =>\\n    loadFromStorage(STORAGE_KEYS.tasks, createInitialTasks)\\n  );\\n  const [projects, setProjects] = useState<Project[]>(() =>\\n    loadFromStorage(STORAGE_KEYS.projects, createInitialProjects)\\n  );\\n  const [preferences, setPreferences] = useState<UserPreferences>(() =>\\n    loadFromStorage(STORAGE_KEYS.prefs, () => DEFAULT_PREFERENCES)\\n  );\\n  const [reflection, setReflection] = useState<ReflectionEntry>(() =>\\n    loadFromStorage(STORAGE_KEYS.reflection, createInitialReflection)\\n  );\\n\\n  const [lastDeletedTask, setLastDeletedTask] = useState<Task | null>(null);\\n\\n  useEffect(() => {\\n    try {\\n      localStorage.setItem(STORAGE_KEYS.tasks, JSON.stringify(tasks));\\n    } catch {\\n      // Ignore storage quota errors\\n    }\\n  }, [tasks]);\\n\\n  useEffect(() => {\\n    try {\\n      localStorage.setItem(STORAGE_KEYS.projects, JSON.stringify(projects));\\n    } catch {\\n      // Ignore storage quota errors\\n    }\\n  }, [projects]);\\n\\n  useEffect(() => {\\n    try {\\n      localStorage.setItem(STORAGE_KEYS.prefs, JSON.stringify(preferences));\\n    } catch {\\n      // Ignore storage quota errors\\n    }\\n  }, [preferences]);\\n\\n  useEffect(() => {\\n    try {\\n      localStorage.setItem(STORAGE_KEYS.reflection, JSON.stringify(reflection));\\n    } catch {\\n      // Ignore storage quota errors\\n    }\\n  }, [reflection]);\\n\\n  const addTask = useCallback(\\n    (input: {\\n      title: string;\\n      notes?: string;\\n      priority?: Priority;\\n      dueDate?: string | null;\\n      projectId?: string | null;\\n      estimateMinutes?: number | null;\\n      status?: TaskStatus;\\n    }): Task => {\\n      const now = new Date().toISOString();\\n      const newTask: Task = {\\n        id: `task-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,\\n        title: input.title.trim(),\\n        notes: input.notes ?? \'\',\\n        completed: input.status === \'done\',\\n        status: input.status ?? \'todo\',\\n        priority: input.priority ?? \'normal\',\\n        dueDate: input.dueDate ?? null,\\n        projectId: input.projectId ?? null,\\n        estimateMinutes: input.estimateMinutes ?? null,\\n        subtasks: [],\\n        createdAt: now,\\n        completedAt: input.status === \'done\' ? now : null,\\n        order: Date.now(),\\n      };\\n      setTasks((prev) => [newTask, ...prev]);\\n      return newTask;\\n    },\\n    []\\n  );\\n\\n  const toggleTask = useCallback((taskId: string) => {\\n    setTasks((prev) =>\\n      prev.map((t) => {\\n        if (t.id !== taskId) return t;\\n        const nextCompleted = !t.completed;\\n        return {\\n          ...t,\\n          completed: nextCompleted,\\n          status: nextCompleted ? \'done\' : \'todo\',\\n          completedAt: nextCompleted ? new Date().toISOString() : null,\\n        };\\n      })\\n    );\\n  }, []);\\n\\n  const updateTask = useCallback((taskId: string, patch: Partial<Task>) => {\\n    setTasks((prev) =>\\n      prev.map((t) => {\\n        if (t.id !== taskId) return t;\\n        const merged = { ...t, ...patch };\\n        if (patch.status !== undefined && patch.completed === undefined) {\\n          merged.completed = patch.status === \'done\';\\n          merged.completedAt = merged.completed ? t.completedAt ?? new Date().toISOString() : null;\\n        } else if (patch.completed !== undefined && patch.status === undefined) {\\n          merged.status = patch.completed ? \'done\' : \'todo\';\\n          merged.completedAt = patch.completed ? t.completedAt ?? new Date().toISOString() : null;\\n        }\\n        return merged;\\n      })\\n    );\\n  }, []);\\n\\n  const deleteTask = useCallback((taskId: string) => {\\n    setTasks((prev) => {\\n      const target = prev.find((t) => t.id === taskId) || null;\\n      if (target) setLastDeletedTask(target);\\n      return prev.filter((t) => t.id !== taskId);\\n    });\\n  }, []);\\n\\n  const undoDeleteTask = useCallback(() => {\\n    if (!lastDeletedTask) return;\\n    setTasks((prev) => [lastDeletedTask, ...prev]);\\n    setLastDeletedTask(null);\\n  }, [lastDeletedTask]);\\n\\n  const dismissDeletedToast = useCallback(() => {\\n    setLastDeletedTask(null);\\n  }, []);\\n\\n  const addSubtask = useCallback((taskId: string, title: string) => {\\n    const trimmed = title.trim();\\n    if (!trimmed) return;\\n    const sub: Subtask = {\\n      id: `st-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,\\n      title: trimmed,\\n      completed: false,\\n    };\\n    setTasks((prev) =>\\n      prev.map((t) => (t.id === taskId ? { ...t, subtasks: [...t.subtasks, sub] } : t))\\n    );\\n  }, []);\\n\\n  const toggleSubtask = useCallback((taskId: string, subtaskId: string) => {\\n    setTasks((prev) =>\\n      prev.map((t) =>\\n        t.id === taskId\\n          ? {\\n              ...t,\\n              subtasks: t.subtasks.map((s) =>\\n                s.id === subtaskId ? { ...s, completed: !s.completed } : s\\n              ),\\n            }\\n          : t\\n      )\\n    );\\n  }, []);\\n\\n  const deleteSubtask = useCallback((taskId: string, subtaskId: string) => {\\n    setTasks((prev) =>\\n      prev.map((t) =>\\n        t.id === taskId\\n          ? { ...t, subtasks: t.subtasks.filter((s) => s.id !== subtaskId) }\\n          : t\\n      )\\n    );\\n  }, []);\\n\\n  const addProject = useCallback(\\n    (input: { name: string; description: string; accent: ProjectAccent }): Project => {\\n      const proj: Project = {\\n        id: `proj-${Date.now()}`,\\n        name: input.name.trim(),\\n        description: input.description.trim(),\\n        accent: input.accent,\\n        createdAt: new Date().toISOString(),\\n      };\\n      setProjects((prev) => [...prev, proj]);\\n      return proj;\\n    },\\n    []\\n  );\\n\\n  const updateProject = useCallback((projectId: string, patch: Partial<Project>) => {\\n    setProjects((prev) => prev.map((p) => (p.id === projectId ? { ...p, ...patch } : p)));\\n  }, []);\\n\\n  const deleteProject = useCallback((projectId: string) => {\\n    setProjects((prev) => prev.filter((p) => p.id !== projectId));\\n    setTasks((prev) =>\\n      prev.map((t) => (t.projectId === projectId ? { ...t, projectId: null } : t))\\n    );\\n  }, []);\\n\\n  const updatePreferences = useCallback((patch: Partial<UserPreferences>) => {\\n    setPreferences((prev) => ({ ...prev, ...patch }));\\n  }, []);\\n\\n  const updateReflection = useCallback((patch: Partial<ReflectionEntry>) => {\\n    setReflection((prev) => ({\\n      ...prev,\\n      ...patch,\\n      weekKey: getWeekKey(),\\n      updatedAt: new Date().toISOString(),\\n    }));\\n  }, []);\\n\\n  const resetWorkspace = useCallback(() => {\\n    const freshTasks = createInitialTasks();\\n    const freshProjects = createInitialProjects();\\n    const freshReflection = createInitialReflection();\\n    setTasks(freshTasks);\\n    setProjects(freshProjects);\\n    setPreferences(DEFAULT_PREFERENCES);\\n    setReflection(freshReflection);\\n    setLastDeletedTask(null);\\n  }, []);\\n\\n  return {\\n    tasks,\\n    projects,\\n    preferences,\\n    reflection,\\n    lastDeletedTask,\\n    addTask,\\n    toggleTask,\\n    updateTask,\\n    deleteTask,\\n    undoDeleteTask,\\n    dismissDeletedToast,\\n    addSubtask,\\n    toggleSubtask,\\n    deleteSubtask,\\n    addProject,\\n    updateProject,\\n    deleteProject,\\n    updatePreferences,\\n    updateReflection,\\n    resetWorkspace,\\n  };\\n}\\n\", \"Description\":\"Create useTaskStore hook for full task, project, subtask, reflection, and preferences state management with localStorage persistence\", \"Overwrite\":true, \"TargetFile\":\"/src/hooks/useTaskStore.ts\", \"toolAction\":\"Creating task store hook\", \"toolSummary\":\"Create src/hooks/useTaskStore.ts\"}"
      original_name: "write_to_file"
    }
    thinking_duration {
      seconds: 2
      nanos: 145145843
    }
    stop_reason: STOP_REASON_STOP_PATTERN
    provider_assigned_message_id: "Lzr_arzzJ5-M28oPlrvvkAM"
  }
}
