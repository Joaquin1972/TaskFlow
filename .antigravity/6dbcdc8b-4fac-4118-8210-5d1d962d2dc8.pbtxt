      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Update index.html title, meta tags, and load Plus Jakarta Sans and JetBrains Mono fonts\", \"EndLine\":17, \"Instruction\":\"Sync title/meta with metadata.json and add Google Fonts\", \"ReplacementContent\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n  <head>\\n    <meta charset=\\\"UTF-8\\\" />\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\" />\\n    <title>TaskFlow Narrative \342\200\224 Focused Task & Project Workspace</title>\\n    <meta name=\\\"description\\\" content=\\\"High-efficiency personal task and project workflow workspace with focused daily planning, upcoming schedules, and narrative progress insights.\\\" />\\n    <meta property=\\\"og:title\\\" content=\\\"TaskFlow Narrative \342\200\224 Focused Task & Project Workspace\\\" />\\n    <meta property=\\\"og:description\\\" content=\\\"High-efficiency personal task and project workflow workspace with focused daily planning, upcoming schedules, and narrative progress insights.\\\" />\\n    <meta property=\\\"og:type\\\" content=\\\"website\\\" />\\n    <meta name=\\\"twitter:card\\\" content=\\\"summary_large_image\\\" />\\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.googleapis.com\\\" />\\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.gstatic.com\\\" crossorigin />\\n    <link href=\\\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap\\\" rel=\\\"stylesheet\\\" />\\n  </head>\\n  <body class=\\\"bg-[#F8FAFC] text-[#0F172A] antialiased selection:bg-[#DBEAFE] selection:text-[#00174B]\\\">\\n    <div id=\\\"root\\\"></div>\\n    <script type=\\\"module\\\" src=\\\"/src/main.tsx\\\"></script>\\n  </body>\\n</html>\", \"StartLine\":1, \"TargetContent\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n  <head>\\n    <meta charset=\\\"UTF-8\\\" />\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\" />\\n    <title>My Google AI Studio App</title>\\n    <meta name=\\\"description\\\" content=\\\"An application built with Google AI Studio.\\\" />\\n    <meta property=\\\"og:title\\\" content=\\\"My Google AI Studio App\\\" />\\n    <meta property=\\\"og:description\\\" content=\\\"An application built with Google AI Studio.\\\" />\\n    <meta property=\\\"og:type\\\" content=\\\"website\\\" />\\n    <meta name=\\\"twitter:card\\\" content=\\\"summary_large_image\\\" />\\n  </head>\\n  <body>\\n    <div id=\\\"root\\\"></div>\\n    <script type=\\\"module\\\" src=\\\"/src/main.tsx\\\"></script>\\n  </body>\\n</html>\", \"TargetFile\":\"/index.html\", \"toolAction\":\"Updating index.html with fonts and metadata\", \"toolSummary\":\"Update index.html\"}"
