      thinking_signature: "\022\200\025\n\375\024\001i\024}\023<\352\207_\276s[\237@t\032\331ea\266\037\fS\343\214\317\231p\360\314Ccz\003\371\306HU\265i\243X\257\261lT\224\235\213\006<\274\2109\033E\366b.\315s\305>\003\242\001\265\252\307\347(G\3068\360\201(\331\200\3611 \260\222\314\325\350\002S\303q\274\270\017\374\036X\272\313\277\025b\034\250MJ\257s\231)[\342v\262T\261.\323\215>4N\245\246\026\265\271\3032n\217\023\246\016$p~\021E*9\263&\340ND\233\247\216\201R -\25470\034\253\033\237\022\177}\336\376\222)\234\352K\3152\363m\376\26634X\265=\222\261\232\312\201\333\235\005A\351\312\252\2702y\344\2536h\253U\r\303\037E\344\323\244PY\215\354\321N\331C\205:\306\313\234\371\227\305\366\223e\275\276\255R\324\302\r\336{\261K\034>\365E\344\341\250\202B\375\327-``\272\023\303,\006\3677\303\364\303U\035\v,\315x\245_J\311\377\236\033ZY\262\211+\314\302_\213;\300\351\210\262UG\240c\305\320_\021me%\345\005\215\273\357\327\034?\032#Wp+\223\371\341<\217\235d\2449\266\006\314\213\201!\266\331\221\210\350dlf\233\334\277c\374\323\350\034\356Yd\025\267\336\311\2631\313\204-\3363\205m,\211|\311\177o\230#*6\371K\222\335\366\304\000\235E\370\271O\361#\344\204!\224\320\220GZ\327o\221\215CY/\016bJ\357\245\272\224\220*\0025\347DHx\200@\271\267$\313\325\0341\321\302F\312y\246\243j3S|\257\341q\367s\003\354);ZQ\251a\260\b\222\006u\350A\317\352m\202\373n-\355\365\204\337\375\314\351z`t6\000\b\305\241\202B\246dN(}\364G})\3641e\025\021DO\242\035S\033d\035\025\b\323\277\274\324\233\264b\273\335f\360\215\343\341_\203\031\330~\261mxs\276\364\321\346\222j\233\3754\274v \270\236e\025\316\360\217\340,2Hj\207a\272\312T\244\204\333\370\377-$e\201\267\234\272\302<~H\315\323_\220E`\276g\017\336\244(W\352\330K\307s\363;\202\361\020\002m\261T`5q\311\236\351\225\261\212\300%\366z\3741H\252\230\227\230b\253\234\371\300\030\320P\003\265=]\231\3520a#!(Z7\024Yp\227BC\211\275\321\215\3523\347\241c\236\251\024$qIhnw\312\362\026\232\245a\256\321\t\227\337\350}4\224\244\254?,\313\363a\304\027\034\023\235\330\306a\342\000\034\207\026p\232\263\333\332O\254z\t\247R\274\227\325w&\226\300\325\002\207\342\266\335\242w\243@f\036\212\017\226\235\266\034\364vW\304\221D\035\310J\306^\3110\354\r\317\033\312\201\233\352\234K i\364q\324l\244g\006\304\301yOJ\370K6\306\r\354\301X\350\2531\360\030Y\331\202\203\373\271\035\330\300b%\232\371i\356\200ON\022\272\2144\220\340\255o,\227\212d\257\2409\377Vu\237\3713\370\200=\351_w8\3258\367\377V\271\265\310\270\216\'\250\2421\343\370\247\206QC\365.y\361\202\026\234p\352\271\004\361\316\204\'\337\225D\2468\275\001FI\225:&\2534\313\351a\017\205ih\230V]\243\313:\254\017\321\021\204\332sE0\322\027\213\234\r\207\004\021\216\367\006\255\345[\253\321\3323r$!\231\374\230\353 \342\232\313\224\'\340\313\312K8\201\234\307ks\v\254^\335\334\262\373\221\021 \210\357<\031I\"\'\240u\360\030\r\346;\361.@\334\232[\235\361\235r5D\246\006\177\224\2475\346\373\372\370\373TSS\034\260\b\236S\376\017\000\376\335\r\032\365\337\361Y?\317\351\262\264\353F\2608\236\207\357\034\f\262C\272Dx\230U\374uZ\33056\305\341+\305oN\217\342+,\254\350\204;l\031\373\351\345\244\317II\335Q\361Y\271\2008:\177\003r\276\226\300\346\366XV\372\327~\252k\001qK<\304Rj\224}\275L\3012}\366\235\230\337 #JlfP\272-\255\223i\vU\036\020=\356A\321\262\021\'\361r\235l\370\277R\271\333\v<\263\265\243\200\025\351\272\260\020\2635Fno\256\214\261\r\300GH\2101_\246\001MK\327G.\317~\t\021\v\032\026\022\375e\220\253\266\213a\334\356h~+,m\340\341\256\276\367g4\272w\371=\\r\213\204\017i\3573W\272\233w\254\035\233\345&B\255\376mO`\036\352\204\257\271\323\214\252\002U\330_\305\301nq\214\312\f\r\333^\361\317\317m\203\250le\320\016\200\004\261?\2652\266E\205\244`Ef\227\272c\211D69\357;\rg\327\021\"V\323\351\033\3264G\361\362\004\376\250\345\177E\217\346M\247\222{\271\221t1l6\362\243\222\037\321\320~\a\004\275o\221\220\316\266P\016V\246\354\262\311\034\235:\354\247w^\020x?\323\0302\203D\361%\332\250\034\202\026p\177</\301y\274\246\306\250eaG\232\026\236\251\000J\'Z\346\340]\226t\251\254\300\236\234\000Y\206\235\001\376\235\001{c\267\263\034\321,\323\203\274\321]\205\221p\202\240&h\t1\344\312\241u\034F\3325\306\303\246\211;\257\360L\377U\257V\332\203^\222\254\363\020\177\320\366\330L\000\200\342\331\304\357J\300\251s\305\221]\b\355\263Y\204J\224\324\354Z \021t\323TXL\347\275\256bhf\302B\362\221\246+3\005\"dr\300\0047\037\275\177\207\374)\\\333\302+\377@A\304t\233}L\024\n\371\205\275*\354>HB\315h\330}J\374\006\353[\203\022\216\231!\037\273\353KR\f\362J\t1li~b\020\230 8\025}2u\311\275\324F\213tW\341\a\205K\241\334\257\022\263\020&`\245d\263\347\341*\365M\257L\365\264\206JlA\006cS\356\252\317\240\235M$\352\253\323\274\215@\b\245IP\373f\264\232\311\346/\270d\\\355\202A\352\222\215]4n\222\340m,\017\345\243\022(=;&2mr\372:\256*\030\333\270\202l\221$O\312\332|\277\025x}\317?\vh\273\225\345\313\334)\263>R!\325\220\371\347:_\260\346UW\352|\235\b\244lh\003S}\037\376\033\316\334\t\204\353k<\270\261\366\241\bE\3105\3670\201\370\'\002\242\321\302\036H\217\177\201%H\353\355\225\320E\373,\211\037S\262V\345\201\027\337\tR\264\252\332\020\366\336\034G\370o=\316\021;\342T\343\004\233\345\024\250H\341\233!8\301Rx\237\266\251\306(\236*l\001\204Z#\t\3432v\227\364-O\v\325j%p\341\341\227\327V1\250\205\201\272TK\\U\251=\177C\222\355\245\272\001\241M\320\377\203k\201\302\371\375\236\235\005\357\030\277=d#\t:\341\222\372\365\250#JV\325\355\257\253.xS\220\0023=d\332\235(\367Cw\2367H/\253\335\316\f\225\313#\315\303\334\313/V\316>f\264\351\016\302r\243\233\n\374g\257F\270\371\f\247wL\370\245\342W\203\221\362\321v@{\273\262J\324<V\020H\322fq+(\372\017\370\254V\225\334\302\264\272\317\377\031g76\036J\223\206\246veI\251z\321K\252\302\271\242K\3540\3401\326}]\037p\"K\317!\351\207\341\300\233\3718\241EbS\343\262\232\231z\250\003\210\005\373\373\217\366\300\376\a\3577r\005\"\024\220F\2571\303\a\265\273\232\305\370\342d\031\310\255~/\"B\205\3428G\304\362\315\360\203\036\375\360S/\2429\326\260\035\025\v\244Z\261A\301\265d\004\312O?ydMW\274\225\213j\227\261\025rR@%\211\360\317\263&\235\353\034\353\316E\316FCV\313\351\2