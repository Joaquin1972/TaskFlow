      thinking_signature: "\022\304\b\n\301\b\001i\024}\023\200\026=<\276\233\342\355\222w\262u4\346q\327+\021\023\005G\205\375?\335\236\244p\237\030F)V\215;\330\301\207\003n\336\334\305\025\206\017fW\002\373\200W\215wS\021\177I(\274\335Q6:aM*\022p\371\033*\225\344\rE{\331\364!\377\224\034)\344\352\032!\b\305b\350\314u\310\304\n\255n\322\270\351\251\343\337Xm\345\002F\210-\273\034\337\256\345\2713\214\033\026q\235 ?\3772T<\177d\302\353\025({\276\252\217^\225\243\027g\277\250,\334\347\260\\\341\"\373e\335\371\371\375\340\270\251H$N>\343k\333=\"\247\301\344\265\215\244\265A\240,\335\370\312\377\234b#\025\034\341\217\200c\217u\022|\320n\016\216,\365\326?\227\240I\320\312{\241\004E8\273C\200\2417\336\204\3318\004\345\302\022\216ij\003\026u\\\233\302\351*\n|\006Y\037\223P+\373\334\3255V$e\f\216%UG\004\301b\214\240\037\264D4J1H]p\212\201\2074s\001v\233\f\361\022^\022\033\021\204an{\026\001\316u\016\233s\244}\202\206\374t\305\260Qb\031C\205\365\210\005\232\020\376\001q\367\367?\036_\n\234{\265\355\271N\345\330\306I\366\206\246w$5\035\232r\305\371\227\203\342\276G;2}\315\327B\rC\233\201\206:\357{C\215\210\356\363$.\332:\343\344\246\373R\374\030\346-t\273\242\344\305{\330\274\004\004\236\257\325\277\226\273|\377\276\206*\322\a\030\024\317\320\343\242\302| \340dc\202\'.S\256^\237\2218\265\344\264\200\030\343h9\312\247(0\203N\200\275\361\037\251\244\316\370\321\306\024\327\226\356\252\237\325|\r\341h\035}\036Fk\2031\240\224\315\226o\365\371\t\2440\272h\306W\232\003\220\232\347\322\003\021\306\233\021u\003\345\374@\214\252w\262\300\201\355\271GF\243\214\326\365\243\034\235J\232\351\005\204\361\375\206\223\b\337(\031\\\267\242\344\327\234\245\vY+6\2323\363!\"\316]U(4\032\276\372XD\241\204+D\352\002\036\v\350\367\323\355\350(G@\262\031;\342\200J{\017\210$K\213\345N\026\271\234\232JY`i/\347\276\a\200\223\036\024\016\276\336PX\026eg*o\347\220\005\a\232\334y1\350\212\273\227\201\210\207\036D\364\306<\230\316\372\313\226\353o\3614h\262S\324\301r\210)\370\222\200y\265\024d\310\033#\373\235\305\260E\352,\233\233N\fv\036\216\311\264s\321\2128o\271Q\a\210\206>x\363<X\335+\033O\355_Xj>R\036\327\004\342$6\360\\C!\336\352\320;\231z\\\253J\305VQ\307TL\3368\304\364\307\ff\350\320M\260\311\301\310\375;~\371?\312\277\204\031Gtx\270e\031\302\266\244\025\200\346\272\201F\206\'\274\245\263\364\'\214\273.7G\371\365\'ut\2626\202\240ogN\3335\242%\270\024\303\232:\345+\306\203o\366\255\312d\335\263\032\223\350 \365\215\333\310\256\300\207&\f\355\f6\021\2311\202\001[\275\207{\224O\244 \001\343}\344k\242i\021\333f\033\346\006\032sh\340\201l\207\230\253\016\213c\023\254\316TF\032j\005\227\210\334\023\314\202\260\233c\033\2575\336\022|<\224\265%\222az.\270\277\272>@\016\376\254\334\375\207\347\036\210S\262q\236\206\214\2058\276WoG\356\241\341\244\334B2\334\026\022u1L\300\022\267\224e\227\350\245A{:\273\0378\253\225\357\267@\343,\3127\332^\242B\222U\305Vd\026f\334$Pg\275\333G\371\005\036\327\343\323\275s\033\264\320ee\343b\026M\302\270z\307\003\307\305b\021\320\376_\306\373f\030\356X\233\330\212\033\311\331\020\354!\241\372\242j!X\371\360\315\036\022\371w4E\016(\2676\271\320\247\353 \004f\333\377\272\032\276\002\266m\005L\034\373\226\322\256h\256\240\343>\257S\236\n\376!\035\375#\203\320GyQie.\302Y\346"
